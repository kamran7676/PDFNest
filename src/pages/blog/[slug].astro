---
import Simple from '../../layouts/Simple.astro';
import articles from '../../../content/articles.mjs';
import tools from '../../data/tools.json';
export function getStaticPaths() { return articles.map((a) => ({ params: { slug: a.slug }, props: { a } })); }
const { a } = Astro.props;
const tool = tools.find((t) => t.id === a.tool);
const path = `/blog/${a.slug}/`;
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'Article', headline: a.title, description: a.description,
  datePublished: a.date, dateModified: a.date, mainEntityOfPage: new URL(path, Astro.site).href,
  publisher: { '@type': 'Organization', name: 'PDFNest' } }];
---
<Simple title={`${a.title} | PDFNest`} description={a.description} path={path} jsonLd={jsonLd}>
  <article>
    <h1>{a.title}</h1>
    <small>Published {a.date}</small>
    <Fragment set:html={a.body} />
    {tool && <a class="cta" href={`/${tool.slug}/`}>Try {a.toolName} free →</a>}
  </article>
</Simple>
